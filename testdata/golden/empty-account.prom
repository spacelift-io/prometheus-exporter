# HELP spacelift_build_info Contains build information about the exporter
# TYPE spacelift_build_info gauge
spacelift_build_info{commit="devel",goversion="<goversion>",version="local"} 1
# HELP spacelift_current_billing_period_end_timestamp_seconds The timestamp of the end of the current billing period
# TYPE spacelift_current_billing_period_end_timestamp_seconds gauge
spacelift_current_billing_period_end_timestamp_seconds 1.7546784e+09
# HELP spacelift_current_billing_period_start_timestamp_seconds The timestamp of the start of the current billing period
# TYPE spacelift_current_billing_period_start_timestamp_seconds gauge
spacelift_current_billing_period_start_timestamp_seconds 1.752e+09
# HELP spacelift_current_billing_period_used_private_seconds The amount of private worker usage in the current billing period
# TYPE spacelift_current_billing_period_used_private_seconds gauge
spacelift_current_billing_period_used_private_seconds 0
# HELP spacelift_current_billing_period_used_public_seconds The amount of public worker usage in the current billing period
# TYPE spacelift_current_billing_period_used_public_seconds gauge
spacelift_current_billing_period_used_public_seconds 0
# HELP spacelift_current_billing_period_used_seats The number of seats used in the current billing period
# TYPE spacelift_current_billing_period_used_seats gauge
spacelift_current_billing_period_used_seats 1
# HELP spacelift_public_worker_pool_parallelism The maximum number of simultaneously executing runs on the public worker pool for this account
# TYPE spacelift_public_worker_pool_parallelism gauge
spacelift_public_worker_pool_parallelism 2
# HELP spacelift_public_worker_pool_runs_pending The number of runs in your account currently queued and waiting for a public worker
# TYPE spacelift_public_worker_pool_runs_pending gauge
spacelift_public_worker_pool_runs_pending 0
# HELP spacelift_public_worker_pool_workers_busy The number of currently busy workers in the public worker pool for this account
# TYPE spacelift_public_worker_pool_workers_busy gauge
spacelift_public_worker_pool_workers_busy 0
# HELP spacelift_scrape_collector_duration_seconds Duration of a collector's Spacelift API request on the last scrape.
# TYPE spacelift_scrape_collector_duration_seconds gauge
spacelift_scrape_collector_duration_seconds{collector="aggregates"} <duration>
spacelift_scrape_collector_duration_seconds{collector="publicworkerpool"} <duration>
spacelift_scrape_collector_duration_seconds{collector="usage"} <duration>
spacelift_scrape_collector_duration_seconds{collector="workerpools"} <duration>
# HELP spacelift_scrape_collector_success Whether a collector succeeded on the last scrape (1) or failed (0).
# TYPE spacelift_scrape_collector_success gauge
spacelift_scrape_collector_success{collector="aggregates"} 1
spacelift_scrape_collector_success{collector="publicworkerpool"} 1
spacelift_scrape_collector_success{collector="usage"} 1
spacelift_scrape_collector_success{collector="workerpools"} 1
# HELP spacelift_scrape_collector_supported Whether a collector's data is available on this deployment, tier and API key (1) or not (0). An unsupported collector is not a failure.
# TYPE spacelift_scrape_collector_supported gauge
spacelift_scrape_collector_supported{collector="aggregates"} 1
spacelift_scrape_collector_supported{collector="publicworkerpool"} 1
spacelift_scrape_collector_supported{collector="usage"} 1
spacelift_scrape_collector_supported{collector="workerpools"} 1
# HELP spacelift_scrape_duration_seconds The duration in seconds of the request to the Spacelift API for metrics
# TYPE spacelift_scrape_duration_seconds gauge
spacelift_scrape_duration_seconds <duration>
